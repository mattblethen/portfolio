---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";
import {
  DEFAULT_DESCRIPTION,
  DEFAULT_OG_IMAGE,
  DEFAULT_TITLE,
  buildBreadcrumbJsonLd,
  buildProfessionalServiceJsonLd,
  buildWebSiteJsonLd,
} from "../lib/seo";

const {
  title = DEFAULT_TITLE,
  description = DEFAULT_DESCRIPTION,
  image = DEFAULT_OG_IMAGE,
  noindex = false,
  breadcrumbs = [],
  structuredData = [],
} = Astro.props;

const siteOrigin = Astro.site ? (Astro.site as URL).origin : "https://mattblethen.com";
const canonical = siteOrigin + Astro.url.pathname;
const ogImage =
  typeof image === "string" && image.startsWith("http") ? image : siteOrigin + image;

const crumbList = breadcrumbs.length
  ? breadcrumbs
  : [
      { name: "Home", url: siteOrigin + "/" },
      { name: title, url: canonical },
    ];

const jsonLdBlocks = [
  buildWebSiteJsonLd(siteOrigin),
  buildProfessionalServiceJsonLd(siteOrigin),
  buildBreadcrumbJsonLd(crumbList),
  ...structuredData,
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <title>{title}</title>
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    {noindex ? (
      <meta name="robots" content="noindex, follow" />
    ) : (
      <meta name="robots" content="index, follow" />
    )}
    <link rel="canonical" href={canonical} />

    <meta property="og:site_name" content="Matt Blethen" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#f5f2ea" />

    <link rel="icon" type="image/png" href="/images/brand/mb-logo-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {jsonLdBlocks.map((obj) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(obj)}></script>
    ))}

    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap site-header__inner">
        <a class="brand-lockup" href="/" aria-label="Matt Blethen home">
          <img
            src="/images/brand/mb-header-logo.png"
            alt="Matt Blethen Web Design and Development"
            width="678"
            height="679"
          />
        </a>

        <a class="brand-lockup-mobile" href="/" aria-label="Matt Blethen home">
          <img
            src="/images/brand/mb-logo-icon.png"
            alt="Matt Blethen"
            width="512"
            height="512"
          />
        </a>

        <a class="site-header__mobile-name" href="/">MATT BLETHEN</a>

        <nav class="primary-nav" aria-label="Primary">
          <button
            class="menu-toggle"
            aria-label="Toggle menu"
            aria-expanded="false"
            aria-controls="primary-menu"
          >
            <span></span>
            <span></span>
            <span></span>
          </button>

          <ul id="primary-menu" class="nav-list">
            <li><a href="/#services">Services</a></li>
            <li><a href="/#ready-to-launch">Ready to Launch</a></li>
            <li><a href="/#work">Work</a></li>
            <li><a href="/#about">About</a></li>
            <li><a href="/#faq">FAQ</a></li>
            <li class="nav-list__cta"><a class="btn btn--solid" href="/contact">Let's Talk</a></li>
          </ul>
        </nav>
      </div>
    </header>

    <slot />

    <footer class="site-footer">
      <div class="wrap site-footer__grid">
        <div class="site-footer__brand">
          <img
            src="/images/brand/mb-logo.png"
            alt="Matt Blethen Web Design and Development"
            width="530"
            height="320"
          />
          <p>
            Websites for artists, makers, and small businesses that need something clear,
            credible, and ready to help bring in customers.
          </p>
        </div>

        <div>
          <h2>Services</h2>
          <ul class="footer-list">
            <li><a href="/#services">Custom Websites</a></li>
            <li><a href="/#services">eCommerce Stores</a></li>
            <li><a href="/#ready-to-launch">Ready to Launch Sites</a></li>
          </ul>
        </div>

        <div>
          <h2>Quick Links</h2>
          <ul class="footer-list">
            <li><a href="/#work">Work</a></li>
            <li><a href="/#about">About</a></li>
            <li><a href="/#faq">FAQ</a></li>
            <li><a href="/contact">Contact</a></li>
          </ul>
        </div>

        <div>
          <h2>Let's Connect</h2>
          <ul class="footer-list">
            <li><a href="mailto:mattblethen@gmail.com">mattblethen@gmail.com</a></li>
            <li><span>Remote nationwide</span></li>
            <li><span>Based in Kentucky</span></li>
          </ul>
        </div>
      </div>

      <div class="wrap site-footer__bottom">
        <p>&copy; {new Date().getFullYear()} Matt Blethen. All rights reserved.</p>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var btn = document.querySelector('.menu-toggle');
        var list = document.getElementById('primary-menu');
        if (!btn || !list) return;

        function closeMenu() {
          list.classList.remove('open');
          btn.setAttribute('aria-expanded', 'false');
        }

        btn.addEventListener('click', function () {
          var open = list.classList.toggle('open');
          btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        });

        list.querySelectorAll('a').forEach(function (link) {
          link.addEventListener('click', closeMenu);
        });

        document.addEventListener('keydown', function (e) {
          if (e.key === 'Escape') closeMenu();
        });
      })();
    </script>
    <Analytics />
  </body>
</html>

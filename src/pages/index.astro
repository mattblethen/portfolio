---
import { Image } from "astro:assets";
import { getCollection, type CollectionEntry } from "astro:content";
import Img from "../components/Img.astro";
import Base from "../layouts/Base.astro";
import profileSrc from "../assets/images/profile.png";
import {
  LOCAL_SERVICE_AREAS,
  SITE_URL,
  buildFAQJsonLd,
  buildOfferCatalogJsonLd,
} from "../lib/seo";

const entries = await getCollection("projects");
entries.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const assetUrls = import.meta.glob("../assets/images/**/*", {
  eager: true,
  import: "default",
}) as Record<string, string>;

function resolveAssetUrl(input?: string): string | undefined {
  if (!input) return undefined;
  if (/^https?:\/\//i.test(input)) return input;

  if (input.startsWith("/images/")) {
    const assetsKey = ".." + input.replace("/images", "/assets/images");
    const webpKey = assetsKey.replace(/\.(png|jpg|jpeg|gif)$/i, ".webp");
    if (assetUrls[webpKey]) return assetUrls[webpKey];
    if (assetUrls[assetsKey]) return assetUrls[assetsKey];
  }

  return input;
}

function resolveLegacyAssetKey(input?: string) {
  if (!input || !input.startsWith("/images/")) return undefined;
  return ".." + input.replace("/images", "/assets/images");
}

function resolveAssetSet(input?: string) {
  if (!input) return { src: undefined, mobile: undefined, large: undefined };
  const fallback = resolveAssetUrl(input);
  if (/^https?:\/\//i.test(input)) return { src: fallback, mobile: undefined, large: undefined };

  const assetKey = resolveLegacyAssetKey(input);
  if (!assetKey) return { src: fallback, mobile: undefined, large: undefined };

  const original = assetUrls[assetKey];
  const webp = assetUrls[assetKey.replace(/\.(png|jpg|jpeg|gif)$/i, ".webp")];
  const mobile = assetUrls[assetKey.replace(/\.(png|jpg|jpeg|gif|webp)$/i, "-768.webp")];
  const large = assetUrls[assetKey.replace(/\.(png|jpg|jpeg|gif|webp)$/i, "-1200.webp")];

  return {
    src: large ?? webp ?? original ?? fallback,
    mobile,
    large: large ?? webp ?? original ?? fallback,
  };
}

const placeholder = `data:image/svg+xml;utf8,${encodeURIComponent(
  `<svg xmlns='http://www.w3.org/2000/svg' width='1200' height='675' viewBox='0 0 1200 675'>
    <defs><linearGradient id='g' x1='0' x2='1' y1='0' y2='1'>
      <stop offset='0%' stop-color='#e9eef7'/><stop offset='100%' stop-color='#f6f8fc'/>
    </linearGradient></defs>
    <rect width='100%' height='100%' fill='url(#g)'/>
    <g fill='#8aa0c8' font-family='Inter,system-ui,Segoe UI,Roboto,Arial,sans-serif' font-size='42' font-weight='600' text-anchor='middle' dominant-baseline='middle'>
      <text x='50%' y='50%'>Project Preview</text>
    </g>
  </svg>`,
)}`;

const toCard = ({ slug, data }: CollectionEntry<"projects">) => {
  const title = data.title ?? "Untitled Project";
  const tags = ((data.tags ?? []) as string[]).slice(0, 4);
  const url = `/projects/${slug}/`;
  const hero = (data.hero as string | undefined) ?? placeholder;

  return {
    url,
    img: resolveAssetSet(hero).large ?? resolveAssetSet(hero).src ?? placeholder,
    title,
    summary: data.summary ?? "",
    tags,
    kicker: tags.length ? tags[0] : "Case Study",
    ariaLabel: `View project - ${title}`,
  };
};

function isAvailable(entry: CollectionEntry<"projects">) {
  const tags = (entry.data.tags ?? []).map((x) => (x || "").toLowerCase());
  const status = entry.data.status?.toLowerCase();
  return status === "available" || entry.data.available === true || tags.includes("available");
}

const designCards = entries
  .filter((entry) => {
    const tags = ((entry.data.tags ?? []) as string[]).map((x) => x.toLowerCase());
    return tags.includes("design") || tags.includes("graphic");
  })
  .map(toCard);

const webCards = entries
  .filter((entry) => {
    const tags = ((entry.data.tags ?? []) as string[]).map((x) => x.toLowerCase());
    const isDesignOnly = tags.includes("design") || tags.includes("graphic");
    return !isDesignOnly && !isAvailable(entry);
  })
  .map(toCard);

const availableCards = entries.filter(isAvailable).map(toCard);

const page = {
  title: "Shopify Developer | Remote Nationwide, In Person Around Richmond and Lexington",
  description:
    "Shopify developer and web designer for ecommerce brands and service businesses nationwide, with in-person project meetings available around Richmond, Lexington, and Central Kentucky.",
};

const faqItems = [
  {
    question: "Do you work with clients outside Kentucky?",
    answer:
      "Yes. Most projects are handled remotely for businesses anywhere in the United States through clear milestones, async reviews, and scheduled calls.",
  },
  {
    question: "Can we meet in person in Central Kentucky?",
    answer:
      "Yes. I prefer meeting local clients in Richmond, Lexington, and nearby Central Kentucky cities when that helps move the project faster.",
  },
  {
    question: "Who is the best fit for your work?",
    answer:
      "The best fit is an ecommerce brand or service business that needs stronger design, clearer messaging, and a faster site that turns more visitors into inquiries or sales.",
  },
  {
    question: "What do you usually build?",
    answer:
      "Most projects are Shopify theme upgrades, custom storefront builds, service-business websites, landing pages, and performance-focused redesigns.",
  },
  {
    question: "Do you help after launch?",
    answer:
      "Yes. Ongoing support is available for site updates, conversion improvements, performance tuning, and new features after launch.",
  },
  {
    question: "What does a typical project cost?",
    answer:
      "Smaller optimization or design projects usually start around $1,000. Full Shopify builds or larger website engagements typically fall between $3,000 and $8,000 depending on scope.",
  },
];

const faq = buildFAQJsonLd(faqItems);
const offerCatalog = buildOfferCatalogJsonLd(SITE_URL);
---

<Base {...page} structuredData={[offerCatalog, faq]}>
  <main class="wrap">
    <section class="hero hero--cleanphoto" aria-labelledby="hero-title">
      <div>
        <div class="eyebrow">Remote Nationwide | In Person Around Central Kentucky</div>
        <h1 id="hero-title" class="title">
          Shopify stores and service websites built to look better, load faster, and convert more visitors.
        </h1>
        <p class="lede">
          I work remotely with ecommerce brands and service businesses across the United States. For clients
          around <strong>Richmond</strong>, <strong>Lexington</strong>, and nearby Central Kentucky cities, I
          am happy to meet in person when it helps move the project faster.
        </p>
        <p class="lede">
          The focus is simple: clearer messaging, sharper design, cleaner builds, and fewer friction points
          between a first visit and a sale or inquiry.
        </p>
        <div class="cta-row" style="display:flex; gap:12px; flex-wrap:wrap;">
          <a class="cta" href="/contact">Start a Project</a>
          <a class="cta secondary" href="#projects">See Recent Work</a>
        </div>
      </div>

      <div class="hero-img hero-img--clean">
        <figure class="profile-wrap" aria-label="Profile photo">
          <Image
            src={profileSrc}
            alt="Profile photo of Matt Blethen"
            widths={[256, 320, 380]}
            format="webp"
            sizes="(max-width: 1024px) 45vw, 380px"
            fetchpriority="high"
            loading="eager"
            decoding="async"
            class="profile-photo"
          />
        </figure>
      </div>
    </section>

    <section class="section" aria-labelledby="coverage-title">
      <h2 id="coverage-title">Remote Across the U.S., Best for Local Meetings Around Richmond and Lexington</h2>
      <p class="muted">
        Most work happens remotely through discovery calls, design reviews, milestone check-ins, and concise
        next steps. If you are nearby, I prefer meeting local clients in person when it makes planning,
        content gathering, or approvals easier.
      </p>
      <div class="service-areas-wrap">
        <h3 class="h6">Common Local Meeting Areas</h3>
        <ul class="service-areas" aria-label="Service areas in Central Kentucky">
          {LOCAL_SERVICE_AREAS.map((city) => <li>{city}</li>)}
        </ul>
      </div>
    </section>

    <section class="section" aria-labelledby="who-title">
      <h2 id="who-title">Who I Help</h2>
      <p class="muted">
        I usually work with two groups: ecommerce teams that need a better Shopify storefront, and service
        businesses that need a faster, more credible website that wins more inquiries. That includes local
        trades, medical and dental practices, real estate teams, and other businesses where trust and clarity
        matter as much as design.
      </p>
    </section>

    <section id="projects" class="section" aria-labelledby="projects-title">
      <h2 id="projects-title">Recent Projects</h2>
      <p class="muted">
        Recent Shopify and website work focused on performance, conversion clarity, and stronger brand presentation.
      </p>

      <div class="grid" style="margin-top:14px">
        {webCards.map((card) => (
          <article class="card">
            <a href={card.url} class="thumb" aria-label={card.ariaLabel}>
              <Img
                src={card.img}
                alt={card.title + " preview"}
                width="1200"
                height="675"
                loading="lazy"
                decoding="async"
                style="display:block"
              />
            </a>
            <div class="body">
              <p class="kicker">{card.kicker}</p>
              <h3>{card.title}</h3>
              {card.summary ? <p class="muted">{card.summary}</p> : null}
              <div class="tags">
                {card.tags.map((tag: string) => <span class="tag">{tag}</span>)}
              </div>
              <a class="view" href={card.url}>View project -&gt;</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    {availableCards.length ? (
      <section id="available" class="section" aria-labelledby="available-title">
        <h2 id="available-title">Available Sites</h2>
        <p class="muted">
          Ready-to-adapt Astro demos you can buy as-is or have me tailor to your business and brand.
        </p>

        <div class="grid" style="margin-top:14px">
          {availableCards.map((card) => (
            <article class="card">
              <a href={card.url} class="thumb" aria-label={card.ariaLabel}>
                <Img
                  src={card.img}
                  alt={card.title + " preview"}
                  width="1200"
                  height="675"
                  loading="lazy"
                  decoding="async"
                  style="display:block"
                />
              </a>
              <div class="body">
                <p class="kicker">Available</p>
                <h3>{card.title}</h3>
                {card.summary ? <p class="muted">{card.summary}</p> : null}
                <div class="tags">
                  {card.tags.map((tag: string) => <span class="tag">{tag}</span>)}
                </div>
                <a class="view" href={card.url}>View demo -&gt;</a>
              </div>
            </article>
          ))}
        </div>
      </section>
    ) : null}

    {designCards.length ? (
      <section id="design" class="section" aria-labelledby="design-title">
        <h2 id="design-title">Graphic Design</h2>
        <p class="muted">
          Logos, brand systems, campaign art, and UI comps built with web use in mind. You can hire me for
          design-only work or pair design with development for a smoother launch.
        </p>

        <div class="grid design-grid" style="margin-top:10px">
          {designCards.map((card) => (
            <article class="card compact" style="--card-scale:0.94">
              <a href={card.url} class="thumb" aria-label={card.ariaLabel}>
                <Img
                  src={card.img}
                  alt={card.title + " preview"}
                  width="1200"
                  height="675"
                  loading="lazy"
                  decoding="async"
                  style="display:block"
                />
              </a>
              <div class="body">
                <p class="kicker">Design</p>
                <h3>{card.title}</h3>
                {card.summary ? <p class="muted">{card.summary}</p> : null}
                <div class="tags">
                  {card.tags.map((tag: string) => <span class="tag">{tag}</span>)}
                </div>
                <a class="view" href={card.url}>View case -&gt;</a>
              </div>
            </article>
          ))}
        </div>
      </section>
    ) : null}

    <section id="services" class="section" aria-labelledby="services-title">
      <h2 id="services-title">Services</h2>
      <div class="services" role="list">
        <div class="service" role="listitem">
          <h4>Shopify Design and Development</h4>
          <p>Custom storefronts, theme rebuilds, and UX improvements that make the store easier to browse and easier to buy from.</p>
        </div>
        <div class="service" role="listitem">
          <h4>Website Design for Service Businesses</h4>
          <p>Clear, trust-building marketing sites for local and regional businesses that need stronger leads, not just a prettier homepage.</p>
        </div>
        <div class="service" role="listitem">
          <h4>Speed and Conversion Optimization</h4>
          <p>Performance cleanup, Core Web Vitals improvements, and friction reduction across mobile and desktop.</p>
        </div>
        <div class="service" role="listitem">
          <h4>Design Systems and Brand Assets</h4>
          <p>Logos, campaign graphics, and UI direction that give the website a more cohesive and more credible presentation.</p>
        </div>
        <div class="service" role="listitem">
          <h4>Integrations and Workflow Support</h4>
          <p>Email, reviews, subscriptions, fulfillment, and operational tools connected so the site supports the business behind it.</p>
        </div>
        <div class="service" role="listitem">
          <h4>Ongoing Support</h4>
          <p>Post-launch updates, testing, and incremental improvements so the site keeps getting better instead of going stale.</p>
        </div>
      </div>
    </section>

    <section class="section" aria-labelledby="faq-title">
      <h2 id="faq-title">FAQs</h2>
      {faqItems.map((item) => (
        <details>
          <summary>{item.question}</summary>
          <p>{item.answer}</p>
        </details>
      ))}
    </section>

    <section class="cta-banner" aria-label="Contact banner">
      <p>
        <strong>Need a sharper storefront or a website that converts more of the right people?</strong>
        <br />
        Remote projects are welcome nationwide. If you are around Richmond, Lexington, or nearby, I am glad to meet locally.
      </p>
      <div class="cta-row cta-banner__actions">
        <a class="cta" href="/contact">Start a Project</a>
      </div>
    </section>
  </main>

  <style>
    .service-areas-wrap { margin-top: 10px; }
    .h6 {
      font-size: 0.95rem;
      letter-spacing: 0.02em;
      text-transform: uppercase;
      color: var(--muted, #5b6472);
    }
    .service-areas {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
      gap: 8px 14px;
      margin: 8px 0 0;
      padding: 0;
      list-style: none;
    }
    .service-areas li { color: var(--muted, #5b6472); font-size: 0.95rem; }

    details {
      border: 1px solid rgba(0,0,0,0.08);
      border-radius: 10px;
      padding: 12px 14px;
      margin: 10px 0;
      background: rgba(0,0,0,0.02);
    }
    summary { cursor: pointer; font-weight: 600; }
    details[open] { background: rgba(0,0,0,0.04); }
  </style>
</Base>

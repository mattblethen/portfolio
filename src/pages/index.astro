---
import { getCollection, type CollectionEntry } from "astro:content";
import Img from "../components/Img.astro";
import Base from "../layouts/Base.astro";
import { Image } from "astro:assets";
import ctaBgSrc from "../assets/images/castle-hero.png";
import { SITE_URL, buildFAQJsonLd, buildOfferCatalogJsonLd } from "../lib/seo";

const entries = await getCollection("projects");
entries.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const assetUrls = import.meta.glob("../assets/images/**/*", {
  eager: true,
  import: "default",
}) as Record<string, string>;

function resolveAssetUrl(input?: string): string | undefined {
  if (!input) return undefined;
  if (/^https?:\/\//i.test(input)) return input;

  if (input.startsWith("/images/")) {
    const assetsKey = ".." + input.replace("/images", "/assets/images");
    const webpKey = assetsKey.replace(/\.(png|jpg|jpeg|gif)$/i, ".webp");
    if (assetUrls[webpKey]) return assetUrls[webpKey];
    if (assetUrls[assetsKey]) return assetUrls[assetsKey];
  }

  return input;
}

function resolveLegacyAssetKey(input?: string) {
  if (!input || !input.startsWith("/images/")) return undefined;
  return ".." + input.replace("/images", "/assets/images");
}

function resolveAssetSet(input?: string) {
  if (!input) return { src: undefined, mobile: undefined, large: undefined };
  const fallback = resolveAssetUrl(input);
  if (/^https?:\/\//i.test(input)) return { src: fallback, mobile: undefined, large: undefined };

  const assetKey = resolveLegacyAssetKey(input);
  if (!assetKey) return { src: fallback, mobile: undefined, large: undefined };

  const original = assetUrls[assetKey];
  const webp = assetUrls[assetKey.replace(/\.(png|jpg|jpeg|gif)$/i, ".webp")];
  const mobile = assetUrls[assetKey.replace(/\.(png|jpg|jpeg|gif|webp)$/i, "-768.webp")];
  const large = assetUrls[assetKey.replace(/\.(png|jpg|jpeg|gif|webp)$/i, "-1200.webp")];

  return {
    src: large ?? webp ?? original ?? fallback,
    mobile,
    large: large ?? webp ?? original ?? fallback,
  };
}

const placeholder = `data:image/svg+xml;utf8,${encodeURIComponent(
  `<svg xmlns='http://www.w3.org/2000/svg' width='1200' height='900' viewBox='0 0 1200 900'>
    <rect width='100%' height='100%' fill='#efe8da'/>
    <text x='50%' y='50%' fill='#44503f' font-family='Georgia, serif' font-size='46' text-anchor='middle'>Project Preview</text>
  </svg>`,
)}`;

const toCard = ({ slug, data }: CollectionEntry<"projects">) => {
  const title = data.title ?? "Untitled Project";
  const tags = ((data.tags ?? []) as string[]).slice(0, 3);
  const url = `/projects/${slug}/`;
  const hero = (data.hero as string | undefined) ?? placeholder;

  return {
    url,
    img: resolveAssetSet(hero).large ?? resolveAssetSet(hero).src ?? placeholder,
    title,
    summary: data.summary ?? "",
    tags,
    client: data.client ?? "Case Study",
  };
};

function isAvailable(entry: CollectionEntry<"projects">) {
  const tags = (entry.data.tags ?? []).map((x) => (x || "").toLowerCase());
  const status = entry.data.status?.toLowerCase();
  return status === "available" || entry.data.available === true || tags.includes("available");
}

function isDesignOnly(entry: CollectionEntry<"projects">) {
  const tags = ((entry.data.tags ?? []) as string[]).map((x) => x.toLowerCase());
  return tags.includes("design") || tags.includes("graphic");
}

const recentWork = entries.filter((entry) => !isAvailable(entry) && !isDesignOnly(entry)).slice(0, 5).map(toCard);
const availableCards = entries.filter(isAvailable).slice(0, 3).map(toCard);

const serviceOffers = [
  {
    icon: "monitor",
    title: "Custom Websites",
    summary: "Fully custom sites built around your brand, your goals, and how you work.",
    points: ["Strategy & planning", "Custom design", "Mobile-friendly build", "SEO-ready structure"],
    href: "/contact",
    cta: "Learn more",
  },
  {
    icon: "cart",
    title: "eCommerce Stores",
    summary: "Online stores that make it easy for people to find what they need and buy with confidence.",
    points: ["Shopify solutions", "Product-first design", "Smoother mobile UX", "Made to scale"],
    href: "/contact",
    cta: "Learn more",
  },
  {
    icon: "rocket",
    title: "Ready to Launch Sites",
    summary:
      "Start with a proven foundation, then I tailor it to your brand, content, and goals so it feels like your business.",
    points: ["Pre-built layouts that convert", "Faster turnaround", "Lower starting investment", "Customized for your brand"],
    href: "#ready-to-launch",
    cta: "Explore options",
  },
];

const proofPillars = [
  {
    badge: "DC",
    title: "Direct Communication",
    text: "You work with me one-on-one, not through layers of account management.",
  },
  {
    badge: "BY",
    title: "Built Around You",
    text: "Every site is tailored to your brand, your goals, and how you actually work.",
  },
  {
    badge: "TS",
    title: "Thoughtful Structure",
    text: "Strategy, design, and content structure are shaped to be clear and usable.",
  },
  {
    badge: "RG",
    title: "Ready to Grow",
    text: "Built to help people trust you, take action, and come back when they are ready.",
  },
];

const page = {
  title: "Matt Blethen | Websites for Artists, Makers, and Small Businesses",
  description:
    "Personal, conversion-focused websites for artists, makers, shops, and service businesses that need something clear, credible, and built to bring in real customers.",
};

const faqItems = [
  {
    question: "Who do you usually work with?",
    answer:
      "Mostly artists, makers, small shops, and service businesses that want something more personal than a template and more grounded than a big agency process.",
  },
  {
    question: "Do you only build custom sites?",
    answer:
      "No. Some projects are fully custom, and some start from a ready-to-launch foundation that gets tailored to fit your brand and goals.",
  },
  {
    question: "Can you help if I am not local?",
    answer:
      "Yes. Most projects can be handled remotely, with a simple process built around conversation, feedback, and steady progress.",
  },
  {
    question: "What happens after launch?",
    answer:
      "You are not left on your own. I can help with updates, improvements, and the next round of refinements once the site is live.",
  },
];

const faq = buildFAQJsonLd(faqItems);
const offerCatalog = buildOfferCatalogJsonLd(SITE_URL);
---

<Base {...page} structuredData={[offerCatalog, faq]}>
  <main class="home-v2">
    <section class="hero-v2" aria-labelledby="hero-title">
      <div class="hero-v2__wash"></div>
      <div class="hero-v2__inner wrap">
        <div class="hero-v2__copy">
          <p class="hero-v2__eyebrow">Built with heart. Designed with purpose. Made to work.</p>
          <h1 id="hero-title">
            <span>Websites that bring</span>
            <span>your vision to life</span>
            <span>and <em>your</em></span>
            <span><em><u>people</u> to you.</em></span>
          </h1>
          <p class="hero-v2__lede">
            Custom websites for creative entrepreneurs and small businesses ready to grow.
          </p>
          <div class="hero-v2__actions">
            <a class="btn btn--solid" href="#work">View My Work</a>
            <a class="btn btn--ghost" href="#ready-to-launch">Explore Ready to Launch Sites</a>
          </div>
        </div>

        <div class="hero-v2__visual" aria-hidden="true">
          <Img
            class="hero-v2__composite"
            src="/images/hero/homepage-hero-collage.png"
            alt=""
            width="1800"
            height="1400"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
        </div>
      </div>
    </section>

    <section class="trust-strip" aria-label="Trust points">
      <div class="trust-strip__inner wrap">
        <article>
          <span class="trust-strip__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10.5 13.5 8 16a3 3 0 1 1-4.24-4.24l3-3A3 3 0 0 1 11 8" />
              <path d="M13.5 10.5 16 8a3 3 0 1 1 4.24 4.24l-3 3A3 3 0 0 1 13 16" />
              <path d="m9 15 6-6" />
            </svg>
          </span>
          <div class="trust-strip__body">
            <h2>Built to Connect</h2>
            <p>Clear sites that turn visitors into customers.</p>
          </div>
        </article>
        <article>
          <span class="trust-strip__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <circle cx="12" cy="12" r="3.2" />
              <path d="M12 2.8v2.1M12 19.1v2.1M4.93 4.93l1.48 1.48M17.59 17.59l1.48 1.48M2.8 12h2.1M19.1 12h2.1M4.93 19.07l1.48-1.48M17.59 6.41l1.48-1.48" />
            </svg>
          </span>
          <div class="trust-strip__body">
            <h2>Easy to Manage</h2>
            <p>Simple to update so your site can keep up with your work.</p>
          </div>
        </article>
        <article>
          <span class="trust-strip__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 21s6-5.2 6-11a6 6 0 1 0-12 0c0 5.8 6 11 6 11Z" />
              <circle cx="12" cy="10" r="2.2" />
            </svg>
          </span>
          <div class="trust-strip__body">
            <h2>Found Locally</h2>
            <p>SEO-ready to help the right people find you.</p>
          </div>
        </article>
        <article>
          <span class="trust-strip__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M7 17 17 7" />
              <path d="M9 7h8v8" />
            </svg>
          </span>
          <div class="trust-strip__body">
            <h2>Made to Grow</h2>
            <p>Built with your future in mind, not just today.</p>
          </div>
        </article>
      </div>
    </section>

    <section class="offers-section" id="services" aria-labelledby="services-title">
      <div class="offers-section__inner wrap">
        <div class="offers-layout">
          <div class="offers-intro">
            <p class="section-kicker">How I usually work</p>
            <h2 id="services-title">Multiple ways<br />to work together</h2>
            <p>
              Most of my clients start with a conversation. Let&apos;s see if we&apos;re a good fit, then choose
              the path that makes the most sense for your business.
            </p>
            <p class="offers-intro__note">
              <span>Pick the path that fits you<br />(and your goals).</span>
              <span class="offers-intro__arrow" aria-hidden="true">⟶</span>
            </p>
          </div>

          <div class="offers-grid">
            {serviceOffers.map((offer) => (
              <article class="offer-card">
                <div class="offer-card__badge" aria-hidden="true">
                  {offer.icon === "monitor" && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <rect x="3.5" y="4.5" width="17" height="12" rx="1.5"></rect>
                      <path d="M9 19.5h6"></path>
                      <path d="M12 16.5v3"></path>
                    </svg>
                  )}
                  {offer.icon === "cart" && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <circle cx="9" cy="19" r="1.6"></circle>
                      <circle cx="17" cy="19" r="1.6"></circle>
                      <path d="M3.5 4.5h2l2.3 9.2h9.1l2.2-6.9H7.1"></path>
                    </svg>
                  )}
                  {offer.icon === "rocket" && (
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M13 2 5 13h5l-1 9 8-11h-5l1-9Z"></path>
                    </svg>
                  )}
                </div>
                <h3>{offer.title}</h3>
                <p>{offer.summary}</p>
                <ul>
                  {offer.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
                <a class="offer-card__link" href={offer.href}>
                  {offer.cta}
                </a>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="ready-section" id="ready-to-launch" aria-labelledby="ready-title">
      <div class="ready-section__inner wrap">
        <div class="section-heading section-heading--center ready-section__heading">
          <p class="section-kicker">Ready to Launch</p>
          <h2 id="ready-title">A faster path if you already know you need a site.</h2>
          <p>
            Start with a proven foundation, then I tailor it to your brand, content, and goals so it feels like
            your business, not a generic template.
          </p>
        </div>

        {availableCards.length ? (
          <div class="ready-grid">
            {availableCards.map((card) => (
              <article class="mini-project">
                <a href={card.url} class="mini-project__media" aria-label={`View ${card.title}`}>
                  <Img
                    src={card.img}
                    alt={card.title + " preview"}
                    width="1200"
                    height="900"
                    loading="lazy"
                    decoding="async"
                  />
                </a>
                <div class="mini-project__body">
                  <p>{card.client}</p>
                  <h3>{card.title}</h3>
                  <a class="mini-project__link" href={card.url}>View demo</a>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="ready-callout">
            <p>
              Ready-to-launch options are meant for people who want a strong starting point without beginning
              from a blank page. I can show you options and tailor one to fit.
            </p>
            <a class="btn btn--ghost" href="/contact">Ask About Ready to Launch Options</a>
          </div>
        )}
      </div>
    </section>

    <section class="approach-section wrap" id="about" aria-labelledby="about-title">
      <div class="approach-section__copy">
        <p class="section-kicker">Why people like working with me</p>
        <h2 id="about-title">Clear process. Real collaboration. No agency runaround.</h2>
        <p>
          You&apos;ll work directly with me from start to finish, keeping things simple, structured, and clear
          enough that you always know what&apos;s happening and why.
        </p>
        <p>
          I ask good questions, listen well, and build websites that are shaped around your business, not a
          generic process. The result is a site you&apos;re proud of and confident using.
        </p>
        <p class="approach-section__signature">Matt</p>
      </div>

      <div class="approach-grid">
        {proofPillars.map((pillar) => (
          <article class="approach-card">
            <div class="approach-card__badge">{pillar.badge}</div>
            <div>
              <h3>{pillar.title}</h3>
              <p>{pillar.text}</p>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="work-section wrap" id="work" aria-labelledby="work-title">
      <div class="section-heading">
        <div>
          <p class="section-kicker">Recent Work</p>
          <h2 id="work-title">Websites for real people doing real things.</h2>
        </div>
      </div>

      <div class="work-rail" aria-label="Recent projects">
        {recentWork.map((card) => (
          <article class="work-card">
            <a href={card.url} class="work-card__media" aria-label={`View ${card.title}`}>
              <Img
                src={card.img}
                alt={card.title + " preview"}
                width="1200"
                height="900"
                loading="lazy"
                decoding="async"
              />
            </a>
            <div class="work-card__body">
              <p>{card.client}</p>
              <h3>{card.title}</h3>
              <span>View project</span>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="process-section wrap" aria-labelledby="process-title">
      <div class="section-heading section-heading--center">
        <p class="section-kicker">Simple process</p>
        <h2 id="process-title">A simple process</h2>
      </div>

      <div class="process-grid">
        <article>
          <div class="process-grid__step">1</div>
          <h3>Let&apos;s Talk</h3>
          <p>You tell me what you&apos;re building, your goals, and what success looks like.</p>
        </article>
        <article>
          <div class="process-grid__step">2</div>
          <h3>I Build With You</h3>
          <p>You see progress, give feedback, and stay in the loop every step of the way.</p>
        </article>
        <article>
          <div class="process-grid__step">3</div>
          <h3>Launch &amp; Grow</h3>
          <p>Your site goes live ready to bring in customers and grow your business.</p>
        </article>
      </div>

      <p class="process-section__note">No long timelines. No handoffs. Just steady progress.</p>
    </section>

    <section class="faq-section wrap" id="faq" aria-labelledby="faq-title">
      <div class="section-heading">
        <p class="section-kicker">FAQ</p>
        <h2 id="faq-title">A few questions people usually ask.</h2>
      </div>
      <div class="faq-list">
        {faqItems.map((item) => (
          <details>
            <summary>{item.question}</summary>
            <p>{item.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="final-cta">
      <div class="final-cta__bg" aria-hidden="true">
        <Image src={ctaBgSrc} alt="" widths={[960, 1440, 1920]} sizes="100vw" loading="lazy" decoding="async" />
      </div>
      <div class="final-cta__overlay"></div>
      <div class="final-cta__inner wrap">
        <div>
          <h2>Your work deserves a website that works as hard as you do.</h2>
          <p>Let&apos;s build something you&apos;re proud to share.</p>
        </div>
        <div class="final-cta__actions">
          <a class="btn btn--solid" href="/contact">Let&apos;s Talk</a>
          <a class="btn btn--ghost btn--ghost-light" href="#ready-to-launch">Explore Ready to Launch Sites</a>
        </div>
      </div>
    </section>
  </main>
</Base>

---
import Base from "../layouts/Base.astro";
import { buildContactPageJsonLd } from "../lib/seo";
---

<Base
  title="Start a Project | Matt Blethen"
  description="Start a Shopify or website project with Matt Blethen. Remote projects are welcome nationwide, with in-person meetings available around Richmond, Lexington, and Central Kentucky."
  structuredData={[buildContactPageJsonLd()]}
>
  <main class="wrap contact-page">
    <h1>Start a Project</h1>
    <p class="muted">
      Tell me what you are building, what is not working, and what you want the site to do better.
      I work remotely with clients nationwide and prefer meeting local clients around Richmond,
      Lexington, and nearby Central Kentucky cities when it is useful.
    </p>

    <div class="contact-intro">
      <div class="contact-note">
        <h2>Good fit projects</h2>
        <ul>
          <li>Shopify redesigns, theme upgrades, and conversion improvements</li>
          <li>Service-business websites that need stronger trust and lead generation</li>
          <li>Performance, UX, and messaging cleanups on existing sites</li>
        </ul>
      </div>
      <div class="contact-note">
        <h2>Helpful details</h2>
        <ul>
          <li>Current website or store URL</li>
          <li>Main goal, timeline, and priority pages</li>
          <li>Whether you prefer remote collaboration or a local meeting</li>
        </ul>
      </div>
    </div>

    <form
      id="contact-form"
      action="https://formspree.io/f/xjkadkdy"
      method="POST"
      class="contact-form"
      novalidate
    >
      <label for="name">
        Name
        <input
          id="name"
          type="text"
          name="name"
          required
          autocomplete="name"
          placeholder="Your name"
        />
      </label>

      <label for="email">
        Email
        <input
          id="email"
          type="email"
          name="_replyto"
          required
          autocomplete="email"
          inputmode="email"
          placeholder="you@example.com"
        />
      </label>

      <label for="message">
        Project details
        <textarea
          id="message"
          name="message"
          rows="7"
          required
          autocomplete="off"
          placeholder="Share your website or store URL, what you need help with, your timeline, and whether you prefer remote collaboration or a local meeting."
        ></textarea>
      </label>

      <input type="hidden" name="_subject" value="New inquiry from mattblethen.com" />
      <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" />

      <button id="submit-btn" type="submit" class="cta">Send Project Details</button>
      <p id="form-status" class="muted" role="status" aria-live="polite" style="min-height:1.2em;"></p>
    </form>
  </main>

  <script is:inline>
    (function () {
      const form = document.getElementById('contact-form');
      const btn = document.getElementById('submit-btn');
      const status = document.getElementById('form-status');

      if (!form || !btn || !status) return;

      function setBusy(isBusy, text) {
        btn.disabled = isBusy;
        btn.textContent = isBusy ? 'Sending...' : 'Send Project Details';
        status.textContent = text || '';
      }

      function validateField(el) {
        if (!el) return true;
        if (!el.checkValidity()) {
          el.setAttribute('aria-invalid', 'true');
          return false;
        }
        el.removeAttribute('aria-invalid');
        return true;
      }

      form.addEventListener('input', (e) => validateField(e.target));

      form.addEventListener('submit', async (e) => {
        const ok =
          validateField(document.getElementById('name')) &&
          validateField(document.getElementById('email')) &&
          validateField(document.getElementById('message'));

        if (!ok) {
          e.preventDefault();
          status.textContent = 'Please fix the highlighted fields.';
          return;
        }

        e.preventDefault();
        setBusy(true);

        try {
          const formData = new FormData(form);
          const resp = await fetch(form.action, {
            method: 'POST',
            body: formData,
            headers: { Accept: 'application/json' },
          });

          if (resp.ok) {
            form.reset();
            setBusy(false, 'Thanks. Your message has been sent.');
          } else {
            setBusy(false, 'Something went wrong. Please try again or email me directly.');
          }
        } catch (err) {
          setBusy(false, 'Network error. Please try again in a moment.');
        }
      });
    })();
  </script>

  <style>
    .contact-intro {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
      margin: 22px 0 24px;
    }
    .contact-note {
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 18px;
      background: var(--card);
    }
    .contact-note h2 {
      margin: 0 0 10px;
      font-size: 1.05rem;
    }
    .contact-note ul {
      margin: 0;
      padding-left: 18px;
      color: var(--muted);
    }
    @media (max-width: 760px) {
      .contact-intro { grid-template-columns: 1fr; }
    }
  </style>
</Base>

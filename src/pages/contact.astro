---
import Base from "../layouts/Base.astro";
import { BUSINESS_EMAIL, buildContactPageJsonLd } from "../lib/seo";
---

<Base
  title="Start a Project | Matt Blethen"
  description="Start a Shopify or website project with Matt Blethen. Remote projects are welcome nationwide, with in-person meetings available around Richmond, Lexington, and Central Kentucky."
  structuredData={[buildContactPageJsonLd()]}
>
  <main class="wrap contact-page">
    <h1>Start a Project</h1>
    <p class="muted">
      Tell me what you are building, what is not working, and what you want the site to do better.
      I work remotely with clients nationwide and prefer meeting local clients around Richmond,
      Lexington, and nearby Central Kentucky cities when it is useful.
    </p>

    <div class="contact-intro">
      <div class="contact-note">
        <h2>Good fit projects</h2>
        <ul>
          <li>Shopify redesigns, theme upgrades, and conversion improvements</li>
          <li>Service-business websites that need stronger trust and lead generation</li>
          <li>Performance, UX, and messaging cleanups on existing sites</li>
        </ul>
      </div>
      <div class="contact-note">
        <h2>Helpful details</h2>
        <ul>
          <li>Current website or store URL</li>
          <li>Main goal, timeline, and priority pages</li>
          <li>Whether you prefer remote collaboration or a local meeting</li>
        </ul>
      </div>
    </div>

    <form
      id="contact-form"
      action={`mailto:${BUSINESS_EMAIL}`}
      method="POST"
      enctype="text/plain"
      class="contact-form"
      data-email={BUSINESS_EMAIL}
      novalidate
    >
      <label for="name">
        Name
        <input
          id="name"
          type="text"
          name="name"
          required
          autocomplete="name"
          placeholder="Your name"
        />
      </label>

      <label for="email">
        Email
        <input
          id="email"
          type="email"
          name="email"
          required
          autocomplete="email"
          inputmode="email"
          placeholder="you@example.com"
        />
      </label>

      <label for="message">
        Project details
        <textarea
          id="message"
          name="message"
          rows="7"
          required
          autocomplete="off"
          placeholder="Share your website or store URL, what you need help with, your timeline, and whether you prefer remote collaboration or a local meeting."
        ></textarea>
      </label>

      <button id="submit-btn" type="submit" class="cta">Open Email Draft</button>
      <p id="form-status" class="muted" role="status" aria-live="polite" style="min-height:1.2em;"></p>
      <p class="muted">
        Or email me directly at <a href={`mailto:${BUSINESS_EMAIL}`}>{BUSINESS_EMAIL}</a>.
      </p>
    </form>
  </main>

  <script is:inline>
    (function () {
      const form = document.getElementById('contact-form');
      const btn = document.getElementById('submit-btn');
      const status = document.getElementById('form-status');

      if (!form || !btn || !status) return;

      const fields = [
        { id: 'name', label: 'name' },
        { id: 'email', label: 'email address' },
        { id: 'message', label: 'project details' },
      ];

      function validateField(el, options = {}) {
        if (!el) return true;

        if (options.trim && 'value' in el) {
          el.value = el.value.trim();
        }

        if (el.required && !el.value) {
          el.setAttribute('aria-invalid', 'true');
          return false;
        }

        if (el.type === 'email') {
          const isEmail = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(el.value);
          if (!isEmail) {
            el.setAttribute('aria-invalid', 'true');
            return false;
          }
        }

        el.removeAttribute('aria-invalid');
        return true;
      }

      function getFieldValue(id) {
        const el = document.getElementById(id);
        return el && 'value' in el ? el.value : '';
      }

      function buildMailtoHref() {
        const recipient = form.dataset.email;
        const subject = 'New inquiry from mattblethen.com';
        const body = [
          `Name: ${getFieldValue('name')}`,
          `Email: ${getFieldValue('email')}`,
          '',
          'Project details:',
          getFieldValue('message'),
        ].join('\n');

        return `mailto:${recipient}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
      }

      form.addEventListener('input', (e) => validateField(e.target));

      form.addEventListener('submit', (e) => {
        e.preventDefault();

        const invalidFields = fields.filter((field) => {
          const el = document.getElementById(field.id);
          return !validateField(el, { trim: true });
        });

        if (invalidFields.length > 0) {
          const firstInvalid = document.getElementById(invalidFields[0].id);
          firstInvalid?.focus();
          status.textContent = `Please check your ${invalidFields[0].label}.`;
          return;
        }

        window.location.href = buildMailtoHref();
        status.textContent = 'Your email app should open with a draft ready to send.';
      });
    })();
  </script>

  <style>
    .contact-intro {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 16px;
      margin: 22px 0 24px;
    }
    .contact-note {
      border: 1px solid var(--line);
      border-radius: var(--radius);
      padding: 18px;
      background: var(--card);
    }
    .contact-note h2 {
      margin: 0 0 10px;
      font-size: 1.05rem;
    }
    .contact-note ul {
      margin: 0;
      padding-left: 18px;
      color: var(--muted);
    }
    @media (max-width: 760px) {
      .contact-intro { grid-template-columns: 1fr; }
    }
  </style>
</Base>
